Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Class: pedsim_rviz_plugin/TrackedPersons
      Enabled: true
      Font scale: 1.5
      History as line:
        Value: true
      History size: 15
      Name: TrackedPersons
      Render detection IDs: false
      Render history: true
      Render person visual: true
      Render track IDs: true
      Render velocities: true
      Style:
        Value: Cylinders
      Topic:
        Value: /pedestrian_visualizer/tracked_persons
    - Alpha: 1
      Class: pedsim_rviz_plugin/TrackedGroups
      Enabled: true
      Name: TrackedGroups
      Topic:
        Value: /pedestrian_visualizer/tracked_groups
      Tracked persons topic:
        Value: /pedestrian_visualizer/tracked_persons
    - Alpha: 1
      Class: pedsim_rviz_plugin/SocialRelations
      Enabled: true
      Name: SocialRelations
      Topic:
        Value: /pedestrian_visualizer/social_relations
      Tracked persons topic:
        Value: /pedestrian_visualizer/tracked_persons
    - Alpha: 1
      Class: pedsim_rviz_plugin/SocialActivities
      Enabled: true
      Name: SocialActivities
      Topic:
        Value: /pedestrian_visualizer/social_activities
      Tracked persons topic:
        Value: /pedestrian_visualizer/tracked_persons
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: PedestrianMeshes
      Topic:
        Value: /pedestrian_simulator/visualization
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Walls
      Topic:
        Value: /pedestrian_simulator/walls
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PredictionPaths
      Topic:
        Value: /pedestrian_simulator/prediction_paths
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Robot
      Topic:
        Value: /pedestrian_simulator/robot_position
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Yaw: 0.785
Window Geometry:
  Height: 800
  Width: 1200
