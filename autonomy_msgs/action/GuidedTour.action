# Exhibition guided tour — primary API for 展厅讲解机器人.
# action: /autonomy/guided_tour

# --- goal ---
string task_id
string tour_id                 # Route id for events and ContinueTour
string tour_name                 # Display name (TOUR_STARTED message)
ExhibitPoint[] exhibits
uint32 number_of_loops 1
bool start_from_beginning true   # Each loop starts at start_exhibit_index (or 0)
uint32 start_exhibit_index 0
bool return_to_dock_on_complete true
bool auto_dock_on_low_battery true
float32 low_battery_threshold 20.0
float32 cruise_speed 0.3       # Max linear m/s in hall; 0 = default
# --- result ---
Error error
WaypointStatus[] exhibit_statuses
uint32 completed_exhibits
builtin_interfaces/Duration tour_duration
# --- feedback ---
string tour_id
uint32 current_exhibit_index
string current_exhibit_id
string current_narration_id    # Play when ARRIVED_AT_EXHIBIT fires
TaskState state
float32 progress
bool waiting_for_continue        # True while waiting for ContinueTour
float32 distance_to_next
geometry_msgs/PoseStamped current_pose
