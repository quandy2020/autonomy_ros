# Return to charger (action: /autonomy/dock).
# Analogous to nav2 DockRobot.

# goal
string task_id
bool use_dock_id true          # If true, use dock_id; else use dock field
string dock_id
DockStation dock              # Inline dock when use_dock_id is false
bool navigate_to_staging_pose true
float32 max_staging_time 300.0  # Staging navigation timeout (seconds)
float32 min_battery_level 0.0   # Reserved policy trigger; 0 = ignore
---
# result
Error error
bool success
bool charging
uint16 num_retries
builtin_interfaces/Duration docking_time
---
# feedback
uint8 STAGING=1
uint8 PERCEPTION=2
uint8 ALIGNING=3
uint8 CHARGING=4
uint8 RETRY=5

uint8 state
float32 distance_to_dock
builtin_interfaces/Duration docking_time
uint16 num_retries
