# Enable/disable teleop without a Teleop action (service: /autonomy/set_teleop_mode).
# When enabled, autonomous cmd_vel from stack is disabled.

bool enable
float32 max_linear_speed 0.5   # Reserved for future clamp
float32 max_angular_speed 1.5
bool preempt_other_tasks true  # Acquire muxer with teleop priority
---
bool success
Error error
TaskStatus status
