<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>autonomy_slam</name>
    <version>0.2.1</version>
    <description>ROS2 SLAM package (autonomy_slam)</description>
    <!-- Author/maintainer of the stella_vslam (fork version of OpenVSLAM) -->
    <maintainer email="quandy2020@126.com">quandy</maintainer>

    <license>2-clause BSD</license>
    <url type="website">https://stella-cv.readthedocs.io/</url>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>autonomy</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_components</depend>
    <depend>eigen</depend>
    <depend>libgoogle-glog-dev</depend>
    <depend>image_transport</depend>
    <depend>cv_bridge</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>message_filters</depend>
    <depend>yaml-cpp</depend>
    <depend>tf2</depend>
    <depend>tf2_eigen</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>rosbag2_cpp</depend>

    <exec_depend>rviz2</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>python3-opencv</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
