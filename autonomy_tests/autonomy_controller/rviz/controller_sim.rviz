Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Path
      Name: ReferencePath
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /controller_sim/reference_path
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/Path
      Name: ExecutedPath
      Enabled: true
      Topic:
        Value: /controller_sim/executed_path
      Color: 25; 25; 255
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Topic:
        Value: /controller_sim/local_costmap
      Color Scheme: costmap
      Alpha: 0.55
    - Class: rviz_default_plugins/PointCloud2
      Name: ObstacleCloud
      Enabled: false
      Topic:
        Value: /controller_sim/obstacle_cloud
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 80; 40
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Obstacles
      Enabled: true
      Update Topic:
        Value: /controller_obstacles/update
      Show Axes: false
      Show Descriptions: true
    - Class: rviz_default_plugins/MarkerArray
      Name: MppiCandidates
      Enabled: true
      Topic:
        Value: /controller_sim/mppi_candidates
      Namespaces:
        mppi_candidates: true
        mppi_optimal: true
    - Class: rviz_default_plugins/Path
      Name: MppiOptimalPath
      Enabled: true
      Topic:
        Value: /controller_sim/mppi_optimal_path
      Color: 255; 120; 20
      Line Style: Lines
      Line Width: 0.08
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Name: Interact
    - Class: rviz_default_plugins/MoveCamera
      Name: Move Camera
    - Class: rviz_default_plugins/Select
      Name: Select
    - Class: rviz_default_plugins/FocusCamera
      Name: Focus Camera
    - Class: rviz_default_plugins/Measure
      Name: Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
      Name: SetGoal
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
