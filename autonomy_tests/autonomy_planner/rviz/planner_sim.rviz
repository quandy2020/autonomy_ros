Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Color Scheme: map
      Alpha: 1.0
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner_sim/global_costmap
      Color Scheme: costmap
      Alpha: 0.55
      Draw Behind: false
    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner_sim/plan
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.06
    - Class: rviz_default_plugins/PointCloud2
      Name: ObstacleCloud
      Enabled: true
      Topic:
        Value: /planner_sim/obstacle_cloud
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 80; 40
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Obstacles
      Enabled: true
      Update Topic:
        Value: /planner_obstacles/update
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Name: Interact
    - Class: rviz_default_plugins/MoveCamera
      Name: Move Camera
    - Class: rviz_default_plugins/Select
      Name: Select
    - Class: rviz_default_plugins/FocusCamera
      Name: Focus Camera
    - Class: rviz_default_plugins/Measure
      Name: Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
      Name: SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
      Name: SetGoal
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Focal Point:
        X: 10
        Y: 10
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
