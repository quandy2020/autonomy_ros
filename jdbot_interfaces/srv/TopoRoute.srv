# Request
TopoNode goal
---
# Response
# error_code: 0=成功, 1=目标节点未找到(当前楼层未设置), 2=POI点无效, 3=路径规划失败, 4=内部错误, 5=定位错误
uint8 RETURN_CODE_SUCCESS = 0
uint8 RETURN_CODE_NODE_NOT_FOUND = 1
uint8 RETURN_CODE_POI_NOT_FOUND = 2
uint8 RETURN_CODE_PATH_PLANNING_FAILED = 3
uint8 RETURN_CODE_INTERNAL_ERROR = 4
uint8 RETURN_CODE_LOCALIZATION_ERROR = 5

uint8 error_code
TopoEdge[] paths
string message