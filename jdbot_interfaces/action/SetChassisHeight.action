# 支持相对高度、绝对高度、整体百分比的设置
# Request 设置底盘的高度
float32 height_re       # 目标相对高度（cm）[-5， 5]，-255表示不使用
float32 height_ab       # 目标绝对高度（cm）[0， 10]，-255表示不使用
float32 height_pct      # 目标高度百分比 [0, 100], -255表示不使用
string request_id
---
# Result
bool success            # 1: 成功　0:失败
string message          # result message
---
# Feedback 当前相对、绝对高度
float32 cur_height_re   # 当前相对高度（cm）
float32 cur_height_ab   # 当前绝对高度（cm）
float32 cur_height_pct  # 当前高度百分比%
