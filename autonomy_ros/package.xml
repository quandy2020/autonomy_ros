<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomy_ros</name>
  <version>0.0.0</version>
  <description>ROS 2 bridge to the autonomy navigation core (map, TF, sensors, planning, control)</description>
  <maintainer email="quandy2020@126.com">quandy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>autonomy</depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>map_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>autonomy_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>autonomy_lerobot</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>autonomy_simulator</exec_depend>
  <exec_depend>autonomy_task</exec_depend>
  <exec_depend>autonomy_tools</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_constrained_smoother</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
