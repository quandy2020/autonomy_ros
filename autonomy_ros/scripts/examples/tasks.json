{
  "defaults": {
    "frame": "odom",
    "timeout": 120.0,
    "feedback": false,
    "max_speed": 0.0,
    "pause_between": 1.0
  },
  "poses": {
    "home": { "x": 0.0, "y": 0.0, "z": 0.0, "yaw": 0.0 },
    "point_a": { "x": 1.0, "y": 0.5, "z": 0.0, "yaw": 0.0 },
    "point_b": { "x": 2.0, "y": 1.0, "z": 0.0, "yaw": 1.57 }
  },
  "tasks": {
    "goto_a": {
      "type": "navigate_pose",
      "pose": "point_a",
      "repeat": 1,
      "max_speed": 0.22
    },
    "goto_a_x3": {
      "type": "navigate_pose",
      "pose": "point_a",
      "repeat": 3,
      "pause_between": 2.0,
      "comment": "同一 pose 重复导航 3 次"
    },
    "patrol_ab": {
      "type": "navigate_through",
      "poses": ["point_a", "point_b", "home"],
      "number_of_loops": 1,
      "stop_on_failure": true
    },
    "patrol_ab_x2": {
      "type": "navigate_through",
      "poses": ["point_a", "point_b"],
      "repeat": 2,
      "pause_between": 3.0
    },
    "hall_tour": {
      "type": "guided_tour",
      "goal_file": "guided_tour.json"
    },
    "dock_home": {
      "type": "dock",
      "dock_id": "dock_main"
    }
  },
  "missions": {
    "demo_patrol": {
      "description": "A -> B -> home, then repeat goto A three times",
      "stop_on_failure": true,
      "sequence": [
        "patrol_ab",
        "goto_a_x3"
      ]
    },
    "stress_point_a": {
      "description": "Stress test: navigate to point_a 5 times",
      "stop_on_failure": false,
      "sequence": [
        {
          "type": "navigate_pose",
          "pose": "point_a",
          "repeat": 5,
          "pause_between": 1.5
        }
      ]
    }
  }
}
