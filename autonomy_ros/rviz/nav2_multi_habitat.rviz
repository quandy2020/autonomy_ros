Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: robot1_map
      Topic:
        Value: /robot1/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: robot2_map
      Topic:
        Value: /robot2/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot3_map
      Topic:
        Value: /robot3/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot4_map
      Topic:
        Value: /robot4/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot5_map
      Topic:
        Value: /robot5/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot6_map
      Topic:
        Value: /robot6/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot7_map
      Topic:
        Value: /robot7/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot8_map
      Topic:
        Value: /robot8/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot9_map
      Topic:
        Value: /robot9/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: robot10_map
      Topic:
        Value: /robot10/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: costmap
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: robot1_plan
      Topic:
        Value: /robot1/plan
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: robot2_plan
      Topic:
        Value: /robot2/plan
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot1/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot1/goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Name: Current View
      Pitch: 1.57
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 800
  Width: 1200
