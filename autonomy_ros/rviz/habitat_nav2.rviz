        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /hunav_goals
      Value: false
    - Alpha: 1
      Class: pedsim_rviz_plugin/TrackedPersons
      Color: 130; 130; 130
      Color map offset: 0
      Color transform: Rainbow
      Delete after no. cycles: 100
      Enabled: true
      Excluded person IDs: ""
      Font color: 255; 255; 255
      Font color style: Same color
      Font scale: 1
      History as line:
        Line width: 0.05000000074505806
        Value: false
      History size: 15
      Included person IDs: ""
      Min. history point distance: 0.4000000059604645
      Missed alpha: 0.5
      Name: TrackedPersons
      Occlusion alpha: 0.30000001192092896
      Render covariances:
        Line width: 0.10000000149011612
        Value: false
      Render detection IDs: false
      Render history: false
      Render person visual: true
      Render track IDs: false
      Render track state: false
      Render velocities: false
      Show DELETED tracks: false
      Show MATCHED tracks: true
      Show MISSED tracks: false
      Show OCCLUDED tracks: false
      Style:
        Line width: 0.05000000074505806
        Scaling factor: 1
        Value: Cylinders
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pedestrian_visualizer/tracked_persons
      Tracking frame: map
