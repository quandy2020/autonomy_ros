<?xml version="1.0"?>
<!-- Intel RealSense D435i RGB-D sensor for Gazebo Sim (gz-sim rgbd_camera). -->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="realsense_d435i_sensor" params="namespace">
    <!-- GZ topics: {namespace}camera/{image,depth_image,camera_info,points} -->
    <sensor name="realsense_d435i" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <topic>${namespace}camera</topic>
      <!-- Gazebo renders along sensor +X; align with ROS optical +Z. -->
      <pose>0 0 0 1.5708 0 0</pose>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera name="realsense_d435i">
        <!-- D435 depth HFOV ~87 deg -->
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </xacro:macro>

</sdf>
