Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: robot_description
    - Class: rviz_default_plugins/Map
      Name: HabitatMap
      Enabled: true
      Topic:
        Value: /map
      Color Scheme: map
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: ExplorationCostmap
      Enabled: true
      Topic:
        Value: /exploration/costmap
      Color Scheme: costmap
      Alpha: 0.7
    - Class: rviz_default_plugins/Path
      Name: ExplorationPath
      Enabled: true
      Topic:
        Value: /exploration/path
      Color: 25; 255; 50
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/Pose
      Name: Waypoint
      Enabled: true
      Topic:
        Value: /exploration/waypoint
      Shape: Arrow
      Color: 255; 25; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: ExplorationMarkers
      Enabled: true
      Topic:
        Value: /exploration/markers
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /camera/rgb/image_raw
    - Class: rviz_default_plugins/Image
      Name: TopDown
      Enabled: true
      Topic:
        Value: /camera/topdown/image_raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
